import React, { useState, useEffect } from "react";
import { useParams, Link } from "react-router-dom";
import { Container, Row, Col, Modal } from "react-bootstrap";
import dataGame from "../preco.json";
import Header from "../Components/Header/Header";

function Preco() {

  const [item, setItem] = useState(null);
  const { id } = useParams();

  useEffect(() => {
    const selectedItem = dataGame.find((i) => i.id === parseInt(id));
    setItem(selectedItem);
  }, [id]);

  const [selectedImage, setSelectedImage] = useState(null);

  return (
    <div>
      <Header />

      <div className="container">
        {item ? (
          <>
            <h1>{item.title}</h1>
            <img src={item.imageUrl} alt={item.title} className="img-fluid" />
          </>
        ) : (
          <div>Chargement...</div>
        )}
      </div>

      {item && (
        <>
          <div className="container">
            <h3>Images</h3>

            <Container>
              <Row>
                {item.screen &&
                  item.screen.map((img, i) => (
                    <Col key={i} xs={6} md={3}>
                      <img
                        src={img.img}
                        alt={item.title}
                        className="img-fluid"
                        style={{ cursor: "pointer" }}
                        onClick={() => setSelectedImage(i)}
                      />
                    </Col>
                  ))}
              </Row>
            </Container>

            <Modal
              show={selectedImage !== null}
              onHide={() => setSelectedImage(null)}
              centered
            >
              <Modal.Body>
                {selectedImage !== null && (
                  <img
                    src={item.screen[selectedImage].img}
                    alt={item.title}
                    className="img-fluid"
                  />
                )}
              </Modal.Body>
            </Modal>
          </div>

          <div className="container">
            <h3>Description</h3>
            <p>{item.resume}</p>
          </div>

          <div className="container">
            <h3>Actualités</h3>

            {item.news &&
              item.news.map((v) => (
                <div key={v.id} className="nk-blog-post">
                  <img src={v.imageUrl} alt={v.title} className="img-fluid" />

                  <h4>{v.title}</h4>

                  <p>{v.new.slice(0, 200)}...</p>

                  <Link to={`/article/${item.id}/${v.id}`}>
                    Voir plus
                  </Link>
                </div>
              ))}
          </div>
        </>
      )}
    </div>
  );
}

export default Preco;